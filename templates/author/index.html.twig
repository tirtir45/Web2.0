{# templates/author/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Author List{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Author List</h1>
        
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for author in authors %}
                    <tr>
                        <td>{{ author.id }}</td>
                        <td>{{ author.username }}</td>
                        <td>{{ author.email }}</td>
                        <td>
                            <a href="{{ path('app_author_edit', {'id': author.id}) }}">Edit</a>
                            <a href="{{ path('app_author_delete', {'id': author.id}) }}">Delete</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center">No authors found</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}