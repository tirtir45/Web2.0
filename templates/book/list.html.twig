{% extends 'base.html.twig' %}

{% block title %}Published Books List{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Published Books List</h1>
    
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Publication Date</th>
                <th>Category</th>
                <th>Author</th>
                <th>Published</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for book in books %}
                <tr>
                    <td>{{ book.title }}</td>
                    <td>{{ book.publicationDate|date('Y-m-d') }}</td>
                    <td>{{ book.category ?? 'No Category' }}</td>
                    <td>{{ book.authorB.username ?? 'No Author' }}</td>
                    <td>
                        {% if book.enabled %}
                            <span>{{ book.authorB.nbBooks ?? 0 }}</span>
                        {% else %}
                            <span>Unpublished</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_book_edit', {'id': book.id}) }}">Edit</a>
                        <a href="{{ path('app_book_delete', {'id': book.id}) }}">Delete</a>
                        <a href="{{ path('app_book_show', {'id': book.id}) }}">Show</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">No books found</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}